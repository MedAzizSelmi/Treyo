# ===================================================================
# BYB MATCH BACKEND - APPLICATION CONFIGURATION (TEMPLATE)
# ===================================================================
# This is the TEMPLATE. The real application.properties is gitignored
# because it carries live secrets.
#
# FIRST-TIME SETUP:
#   1. Copy this file to `application.properties` (same folder)
#   2. Replace every CHANGE_ME / YOUR_* placeholder with a real value
#   3. Never commit application.properties — it's in .gitignore
# ===================================================================

# ===================================================================
# SERVER CONFIGURATION
# ===================================================================
server.port=8085
server.error.include-message=always
server.error.include-stacktrace=never

# ===================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===================================================================
spring.datasource.url=jdbc:postgresql://localhost:5432/Matching
spring.datasource.username=postgres
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.open-in-view=false

# ===================================================================
# FILE UPLOAD CONFIGURATION
# ===================================================================
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=20MB

# ===================================================================
# REQUEST SIZE (JSON body — needed for base64 audio/image payloads)
# ===================================================================
server.tomcat.max-http-post-size=-1
server.tomcat.max-swallow-size=-1

# ===================================================================
# JWT CONFIGURATION
# ===================================================================
# Use a long random string (>= 256 bits). Generate one with e.g.:
#   openssl rand -base64 48
jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# 90 days — keeps mobile users signed in until they explicitly log out.
jwt.expiration=7776000000
# 365 days — reserved for /auth/refresh (not currently exposed).
jwt.refresh-expiration=31536000000

# ===================================================================
# SMTP (transactional email — verification + password reset)
# ===================================================================
# Recommended: Mailgun's free tier. SendGrid, AWS SES, and Gmail SMTP
# (with an app password) also work — just swap host + credentials.
spring.mail.host=smtp.mailgun.org
spring.mail.port=587
spring.mail.username=postmaster@sandboxXXXXXX.mailgun.org
spring.mail.password=CHANGE_ME
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true

app.mail.from=no-reply@yourdomain.com
app.mail.from-name=Treyo

# Base URL the email links resolve against. Production = your marketing
# site, which deep-links into the app. Dev = your local web bounce page
# or the Expo dev server.
app.url=https://treyo.app

# ===================================================================
# ML SERVICE CONFIGURATION (FastAPI)
# ===================================================================
ml.service.url=http://localhost:8000
ml.service.endpoints.recommendations=/recommendations/{studentId}
ml.service.endpoints.cold-start=/recommendations/cold-start
ml.service.endpoints.track-interaction=/interactions/track
ml.service.endpoints.trending=/courses/trending
ml.service.endpoints.explain=/recommendations/explain

# ===================================================================
# CORS CONFIGURATION
# ===================================================================
cors.allowed-origins=http://localhost:3000,http://localhost:19006,http://localhost:8081
cors.allowed-methods=GET,POST,PUT,DELETE,PATCH
cors.allowed-headers=*
cors.exposed-headers=Authorization
cors.allow-credentials=true

# ===================================================================
# LOGGING
# ===================================================================
logging.level.root=INFO
logging.level.com.byb.match=DEBUG
logging.level.org.springframework.security=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# ===================================================================
# API DOCUMENTATION (Swagger)
# ===================================================================
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operations-sorter=method
springdoc.swagger-ui.tags-sorter=alpha

# ===================================================================
# APPLICATION INFO
# ===================================================================
spring.application.name=byb-match-backend
info.app.name=BYB Match Backend
info.app.description=AI-powered trainer-student matching platform
info.app.version=1.0.0

# ===================================================================
# GEMINI AI CONFIGURATION
# ===================================================================
# Generate / rotate at https://aistudio.google.com (API keys).
gemini.api.key=YOUR_GEMINI_API_KEY
# Models tried in order (fallback handled in GeminiService): gemini-2.0-flash-lite, gemini-2.0-flash, gemini-flash-lite-latest, gemini-flash-latest

# ===================================================================
# KONNECT PAYMENTS (Tunisian PSP — replaced Stripe so we can charge in TND)
# ===================================================================
# api-key  : "<wallet_owner_id>:<secret>", sent as the x-api-key header
#            on every Konnect call. SERVER-ONLY — never expose to the app.
# wallet-id: the receiverWalletId for the merchant account. Konnect routes
#            funds to this wallet when a payment completes.
# base-url : preprod for sandbox testing, prod for real charges.
#              preprod -> https://api.preprod.konnect.network/api/v2
#              prod    -> https://api.konnect.network/api/v2
# return-url : custom scheme the mobile app handles to detect "user finished
#              the Konnect-hosted payment page and is coming back to us".
# webhook-url: Konnect calls this when a payment changes state. Leave empty
#              in dev (falls back to polling).
konnect.api.key=YOUR_KONNECT_API_KEY
konnect.api.wallet-id=YOUR_KONNECT_WALLET_ID
konnect.api.base-url=https://api.preprod.konnect.network/api/v2
konnect.api.return-url=treyomobile://payment-return
konnect.api.webhook-url=

# File Storage
file.storage.upload-dir=uploads
file.storage.max-file-size=10485760
file.storage.max-profile-picture-size=5242880
file.storage.max-document-size=20971520
