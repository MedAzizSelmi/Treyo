# ===================================================================
# BYB MATCH BACKEND - APPLICATION CONFIGURATION (TEMPLATE)
# ===================================================================
# This is the TEMPLATE. The real application.properties is gitignored
# because it carries live secrets.
#
# FIRST-TIME SETUP:
#   1. Copy this file to `application.properties` (same folder)
#   2. Replace every CHANGE_ME / YOUR_* placeholder with a real value
#   3. Never commit application.properties — it's in .gitignore
# ===================================================================

# ===================================================================
# SERVER CONFIGURATION
# ===================================================================
server.port=8085
server.error.include-message=always
server.error.include-stacktrace=never

# ===================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===================================================================
spring.datasource.url=jdbc:postgresql://localhost:5432/Matching
spring.datasource.username=postgres
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
#
# PRODUCTION: set this to "validate" and apply schema changes through the
# scripts in db/migrations instead. "update" never alters an existing
# constraint, which is how the stale courses_format_check drifted out of
# sync with the application and rejected valid course submissions at
# runtime. "validate" fails fast at startup on that kind of drift.
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.open-in-view=false

# ===================================================================
# FILE UPLOAD CONFIGURATION
# ===================================================================
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=20MB

# ===================================================================
# REQUEST SIZE (JSON body — needed for base64 audio/image payloads)
# ===================================================================
server.tomcat.max-http-post-size=-1
server.tomcat.max-swallow-size=-1

# ===================================================================
# JWT CONFIGURATION
# ===================================================================
# Use a long random string (>= 256 bits). Generate one with e.g.:
#   openssl rand -base64 48
jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Access token lifetime: 1 hour.
#
# This was 90 days. Because the API is stateless there is no revocation
# list, so the token's lifetime IS the exposure window: a token captured
# from a device, a log, or a proxy stayed valid for three months. One
# hour keeps that window small; the refresh token below is what keeps
# users signed in, and it can be invalidated by changing the secret.
jwt.expiration=3600000
# 365 days — reserved for /auth/refresh (not currently exposed).
# Refresh token lifetime: 30 days (was 365). Long enough that a regular
# user is not asked to sign in again, short enough that an abandoned
# device stops working within a month.
jwt.refresh-expiration=2592000000

# ===================================================================
# APPLICATION SECURITY
# ===================================================================
# Browser origins allowed to call this API, comma-separated. Only affects
# browsers — the mobile app is not subject to CORS. Set this to the admin
# dashboard's real origin in production; do NOT use "*" together with
# credentials.
app.cors.allowed-origins=http://localhost:3000

# Interactive API documentation (Swagger UI). Leave false in production:
# it publishes a complete map of every endpoint and payload.
app.swagger.enabled=true

# Throttling for unauthenticated endpoints. Login limits password
# guessing; the email limit also protects our SMTP reputation, since
# those endpoints send mail to an address the caller chooses.
# In-memory and per-instance — move to a shared store if scaled out.
app.ratelimit.enabled=true
app.ratelimit.login-attempts=10
app.ratelimit.email-attempts=5
app.ratelimit.window-minutes=15

# ===================================================================
# SMTP (transactional email — verification + password reset)
# ===================================================================
# Recommended: Mailgun's free tier. SendGrid, AWS SES, and Gmail SMTP
# (with an app password) also work — just swap host + credentials.
spring.mail.host=smtp.mailgun.org
spring.mail.port=587
spring.mail.username=postmaster@sandboxXXXXXX.mailgun.org
spring.mail.password=CHANGE_ME
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true

app.mail.from=no-reply@yourdomain.com
app.mail.from-name=Treyo

# Base URL the email links resolve against. Production = your marketing
# site, which deep-links into the app. Dev = your local web bounce page
# or the Expo dev server.
app.url=https://treyo.app

# ===================================================================
# ML SERVICE CONFIGURATION (FastAPI)
# ===================================================================
ml.service.url=http://localhost:8000
# Shared secret sent as X-ML-API-Key. The ML service holds a direct
# database connection and must never be publicly reachable; set this in
# production to the same value as ML_API_KEY in ml-service/.env, and
# firewall its port as well. Leave empty in local development.
ml.service.api-key=
ml.service.endpoints.recommendations=/recommendations/{studentId}
ml.service.endpoints.cold-start=/recommendations/cold-start
ml.service.endpoints.track-interaction=/interactions/track
ml.service.endpoints.trending=/courses/trending
ml.service.endpoints.explain=/recommendations/explain

# ===================================================================
# CORS CONFIGURATION
# ===================================================================
# (legacy cors.allowed-origins removed - superseded by app.cors.allowed-origins above)
cors.allowed-methods=GET,POST,PUT,DELETE,PATCH
cors.allowed-headers=*
cors.exposed-headers=Authorization
cors.allow-credentials=true

# ===================================================================
# LOGGING
# ===================================================================
# PRODUCTION: keep these at INFO/WARN. Hibernate SQL at DEBUG writes
# every statement (with parameters) to the log, which is both a
# performance drag and a place personal data accumulates in plain text.
# Spring Security at DEBUG similarly logs authentication internals.
logging.level.root=INFO
logging.level.com.byb.match=INFO
logging.level.org.springframework.security=WARN
logging.level.org.hibernate.SQL=WARN
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# ===================================================================
# API DOCUMENTATION (Swagger)
# ===================================================================
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operations-sorter=method
springdoc.swagger-ui.tags-sorter=alpha

# ===================================================================
# APPLICATION INFO
# ===================================================================
spring.application.name=byb-match-backend
info.app.name=BYB Match Backend
info.app.description=AI-powered trainer-student matching platform
info.app.version=1.0.0

# ===================================================================
# GEMINI AI CONFIGURATION
# ===================================================================
# Generate / rotate at https://aistudio.google.com (API keys).
gemini.api.key=YOUR_GEMINI_API_KEY
# Models tried in order (fallback handled in GeminiService): gemini-2.0-flash-lite, gemini-2.0-flash, gemini-flash-lite-latest, gemini-flash-latest

# ===================================================================
# CLICTOPAY PAYMENTS (SMT / ATB — the Tunisian bank gateway)
# ===================================================================
# Konnect was used for prototyping only and has been removed; its
# implementation is in git history if the flow shape is ever needed.
#
# Every value here is issued by the bank once the merchant contract is
# approved — none of it is self-service:
#   affiliate-id : "Numéro Affilié" from the Fiche Technique
#   terminal-id  : "Numéro Terminal" from the same form
#   secret       : the credential SMT provides with the integration spec
#   base-url     : SMT's gateway endpoint, per that spec
#
# return-url-base is the PUBLIC https origin the gateway redirects the
# user back to. /payment/success and /payment/failure are appended, and
# both were declared on the Fiche Technique — they must keep matching
# what was filed, or the bank rejects the redirect.
#
# All five may be left empty. The service starts, free enrollments work
# as normal, and paid ones answer 503 until credentials exist.
clicktopay.api.base-url=
clicktopay.api.affiliate-id=
clicktopay.api.terminal-id=
clicktopay.api.secret=
clicktopay.return-url-base=https://your-domain.example

# File Storage
file.storage.upload-dir=uploads
file.storage.max-file-size=10485760
file.storage.max-profile-picture-size=5242880
file.storage.max-document-size=20971520

# ===================================================================
# HEALTH / MONITORING
# ===================================================================
# Only the health endpoint is exposed; the other actuator endpoints can
# reveal configuration and environment, so they stay off. Point the
# reverse proxy and any uptime monitor at /actuator/health.
management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=never
management.endpoints.enabled-by-default=false
management.endpoint.health.enabled=true
