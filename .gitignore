# ===================================================================
# ROOT .gitignore — keeps secrets and local junk out of the repo.
# Each sub-project (backend/, treyo-mobile/, ml-service/, admin-dashboard/)
# also has its own .gitignore for build artifacts; this one covers
# things that span the whole repo or were missing coverage.
# ===================================================================

# ── Secrets — NEVER commit these ──
# Plain-text key dumps
Treyo API Keys.txt
*api-keys*.txt
*API Keys*.txt

# Env files (real values). The *.example variants ARE committed as
# templates — the negation rules below keep them tracked.
.env
.env.*
!.env.example
!**/.env.example

# Backend secrets — the real application.properties carries DB password,
# JWT secret, Gemini + Konnect keys. Only the .example template is tracked.
backend/src/main/resources/application.properties

# ── Claude Code local settings ──
.claude/settings.local.json

# ── IDE / editor project files ──
# JetBrains (IntelliJ, WebStorm, PyCharm) per-user project config —
# machine-specific, should never be shared. Was tracked in early
# commits; untracked repo-wide from here on.
.idea/
*.iml
*.iws
.vscode/

# ── Python bytecode / caches (repo-wide safety net) ──
__pycache__/
*.py[cod]

# ── Deployment notes (kept local) ──
# Server layout, service names and the hardening steps for the VPS.
# No secrets in it — every credential is a CAPITALS placeholder — but
# it maps the production estate, so it stays off a public repo.
DEPLOYMENT_RUNBOOK.md

# ── Personal / academic documents (kept local, not shared) ──
# The PFE report source + its compiled output and LaTeX build artifacts.
rapport_pfe_byb_match.tex
rapport_pfe_byb_match.pdf
rapport_pfe_byb_match.aux
rapport_pfe_byb_match.log
rapport_pfe_byb_match.out
rapport_pfe_byb_match.toc
rapport_pfe_byb_match.lof
rapport_pfe_byb_match.lot

# ── Database dumps and backups ──
# These contain real user data (names, emails, password hashes). A dump
# taken in the project folder would otherwise be picked up by `git add -A`
# and pushed to GitHub. Prefer dumping outside the repo entirely; these
# patterns are the safety net.
*.dump
*.sql.gz
*.backup
db_*.tar.gz
uploads_*.tar.gz

# ── OS junk ──
.DS_Store
Thumbs.db
