{
  "expo": {
    "name": "Treyo",
    "slug": "treyo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "treyomobile",
      "com.googleusercontent.apps.629625292510-eb62bn8v5eqsisvvpj89kj694mprqmp6",
      "com.googleusercontent.apps.629625292510-v02fdagjn7b419g2nqc796bn5d4ir92e"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.aziz001.treyomobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#250ea9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aziz001.treyomobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7cce06"
        }
      ],
      "expo-localization",
      "expo-apple-authentication",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "social": {
        "googleAndroidClientId": "629625292510-eb62bn8v5eqsisvvpj89kj694mprqmp6.apps.googleusercontent.com",
        "googleIosClientId": "629625292510-v02fdagjn7b419g2nqc796bn5d4ir92e.apps.googleusercontent.com"
      },
      "router": {},
      "eas": {
        "projectId": "3adfcbf4-dd08-43c6-b630-102353c6d7a4"
      }
    }
  }
}
