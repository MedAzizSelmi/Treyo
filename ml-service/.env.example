# TEMPLATE — copy this to `.env` and fill in real values.
# `.env` is gitignored; this `.env.example` is committed as documentation.

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Matching
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# API Configuration
# Loopback only: this service must never be publicly reachable.
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# CORS (allowed origins for Spring Boot to call this service)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ===================================================================
# SERVICE SECURITY
# ===================================================================
# Shared secret required on every request (header X-ML-API-Key), except
# /health. Must match ml.service.api-key in the backend. Leave empty for
# local development; ALWAYS set it in production.
ML_API_KEY=

# Interactive docs (/docs, /redoc) and the /debug/* endpoints. Both stay
# off in production: /debug/student/{id} returns one learner's profile
# and full interaction history.
ML_EXPOSE_DOCS=false
ML_EXPOSE_DEBUG=false
