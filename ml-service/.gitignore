# ===================================================================
# ML SERVICE .gitignore
# ===================================================================

# Secrets — real env file (DB credentials). The .env.example template
# IS committed; the real .env is not.
.env
.env.*
!.env.example

# Python virtual environment
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db
